name: "mxbai_xs_ort"
platform: "onnxruntime_onnx"
max_batch_size: 512

input [
  { name: "input_ids", data_type: TYPE_INT64, dims: [512] },
  { name: "attention_mask", data_type: TYPE_INT64, dims: [512] }
]

output [
  { name: "logits", data_type: TYPE_FP32, dims: [1] }
]

instance_group [{ kind: KIND_GPU, gpus: [0], count: 1 }]

dynamic_batching {
  preferred_batch_size: [16, 32, 64, 128, 256, 512]
  max_queue_delay_microseconds: 2000
}

optimization {
  execution_accelerators {
    gpu_execution_accelerator {
      name: "cuda"
    }
  }
}

default_model_filename: "model.onnx"
